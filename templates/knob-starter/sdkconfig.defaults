# Board: ESP32-S3R8 round knob display — 8 MB octal PSRAM, 16 MB flash.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_KNOB_BOARD_JC3636K518C=y

# PSRAM: everything that tolerates latency goes here (LVGL pool, big buffers, BSS).
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

CONFIG_FREERTOS_HZ=1000

# Run the S3 at full tilt (default is 160 MHz) — headroom for LVGL rendering.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Build -O2 (PERF), not IDF's default -Og (DEBUG). LVGL software rendering is the hot path and the
# QSPI bus is the bottleneck; -O2 is a measurable win on this panel.
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# Custom partition table: 9 MB app + 4 MB SPIFFS + nvs. First flash MUST be over USB so the table
# gets written; after that app-only flashes are fine.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# LVGL object pool: 128K. 64K is exhausted by a few screens' worth of widgets (lv_malloc returns
# NULL → StoreProhibited). Backed by PSRAM (see CMakeLists.txt's LV_ATTRIBUTE_LARGE_RAM_ARRAY +
# CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY below) — 128K of internal SRAM was starving lwIP's
# TCP send buffer during an upload (measured: 8 KB free / 1536 B largest block at the stall).
CONFIG_LV_MEM_SIZE=131072
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

# lwIP TCP send/recv window: the default 5760 B (~4x MSS) means many fill/drain cycles over Wi-Fi
# for a multi-MB PUT. 16 KB each is only allocatable because LVGL's pool left internal RAM (above).
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=16384
CONFIG_LWIP_TCP_WND_DEFAULT=16384
